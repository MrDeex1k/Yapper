---
const repo = 'https://github.com/MrDeex1k/Yapper';
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="An independent home for your community. Self-hosted chat and voice, built in the open."/><title>Yapper — make room for your people</title></head><body>
<header><a href="#" aria-label="Yapper home">y.</a><a href={repo}>Follow the build ↗</a></header>
<main><section class="hero"><div class="sound" aria-hidden="true">{Array.from({length:32},(_,i)=><i style={`--i:${i};--height:${20+Math.sin(i*.61)**2*65}%`}/>)}</div><div class="hero-copy"><p class="label">Independent by design</p><h1>yapper<span>.</span></h1><h2>Make room<br/>for your people.</h2><p>A familiar place to talk. On a server you call your own.</p><a class="cta" href={`${repo}/pulls`}>Review the progress <span>↗</span></a><small>0.5.0 candidate · Under review · No stable release yet</small></div></section>
<section class="support"><p class="label">01 / Your own address</p><h2>Good company.<br/>No central landlord.</h2><p>Your community lives on your infrastructure. Accounts, conversations and the decision to stay belong to you.</p></section>
<section class="workflow"><p class="label">02 / A quieter way to connect</p><ol><li><span>01</span><h3>Set up a home.</h3><p>One independently hosted instance for your group.</p></li><li><span>02</span><h3>Bring your people.</h3><p>Share the address and invite them in.</p></li><li><span>03</span><h3>Stay a while.</h3><p>Chat, voice and desktop candidates are under review. Help test the next version.</p></li></ol></section>
<section class="final"><p class="label">Help shape what comes next</p><h2>Pull up a chair.</h2><a class="cta" href={repo}>Follow Yapper on GitHub ↗</a></section></main><footer><strong>yapper.</strong><span>Independent conversations. AGPL-3.0.</span></footer>
<style>
:global(*){box-sizing:border-box} :global(body){margin:0;background:#171816;color:#eeefe8;font-family:Inter,system-ui,sans-serif} :global(a){color:inherit;text-decoration:none}header{position:absolute;z-index:2;top:0;left:0;right:0;padding:24px 5vw;display:flex;align-items:center;justify-content:space-between;font-size:13px}header>a:first-child{font-size:34px;font-weight:800;color:#e8b663}.hero{min-height:100svh;position:relative;overflow:hidden;display:flex;align-items:center}.hero-copy{position:relative;z-index:1;padding:100px 7vw 50px;max-width:800px;animation:rise .8s ease-out}.label{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#b8beaf}h1{font-size:clamp(100px,20vw,280px);letter-spacing:-.09em;line-height:.85;margin:24px 0 40px}h1 span{color:#e8b663}h2{font-size:clamp(36px,5vw,72px);letter-spacing:-.05em;line-height:1.06;margin:20px 0}p{line-height:1.7;color:#b8beaf;max-width:430px}.cta{display:inline-flex;gap:50px;justify-content:space-between;background:#e8b663;color:#211b11;padding:17px 24px;margin:22px 0;transition:transform .2s,background .2s}.cta:hover{transform:translateY(-3px);background:#f2ca88}small{display:block;color:#939b8b;font-size:11px}.sound{position:absolute;inset:0 0 0 48%;display:flex;gap:1.1vw;align-items:center;transform:rotate(-12deg);opacity:.42;mask-image:linear-gradient(90deg,transparent,black)}.sound i{height:var(--height);width:1.5vw;min-width:5px;background:#e8b663;border-radius:100px;animation:breathe 5s ease-in-out infinite alternate;animation-delay:calc(var(--i)*-.2s)}.support,.workflow,.final{padding:100px 7vw;border-top:1px solid #363933}.support{position:relative}.support p:last-child{margin-left:auto;font-size:19px}ol{list-style:none;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:50px;margin-top:60px}li>span{color:#e8b663;font-size:12px}h3{font-size:28px;letter-spacing:-.04em}.final{background:#22251f}footer{padding:32px 7vw;display:flex;justify-content:space-between;gap:24px;font-size:12px;color:#a7af9e}footer strong{font-size:24px;color:#eeefe8}@keyframes rise{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}@keyframes breathe{to{transform:scaleY(.82)}}@media(max-width:650px){ol{grid-template-columns:1fr;gap:20px}.sound{left:35%;opacity:.18}.hero-copy{padding-top:100px}.support,.workflow,.final{padding:65px 7vw}footer{flex-direction:column}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}
</style></body></html>
