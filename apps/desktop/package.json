{
  "name": "@yapper/desktop",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "renderer"
  ],
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc --noEmit false --outDir dist && tsc -p tsconfig.scripts.json --noEmit false && node scripts/copy-renderer.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "start": "electron .",
    "test": "tsc --noEmit false --outDir .test-build && node --test .test-build/gateway.test.js .test-build/preview.test.js"
  },
  "dependencies": {
    "tough-cookie": "6.1.0"
  },
  "devDependencies": {
    "@yapper/web": "workspace:*",
    "electron": "45.4.1"
  }
}
