PRODUCT_BUNDLE_IDENTIFIER = pl.yapper.mobile
PRODUCT_NAME = Yapper
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
SWIFT_VERSION = 5.0
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SDKROOT = iphoneos
TARGETED_DEVICE_FAMILY = 1,2
CODE_SIGN_STYLE = Automatic
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Yapper
INFOPLIST_KEY_NSMicrophoneUsageDescription = Yapper uses your microphone when you unmute in a voice channel.
INFOPLIST_KEY_NSLocalNetworkUsageDescription = Yapper can connect to a community server on your local network.
INFOPLIST_KEY_UILaunchScreen_Generation = YES
ENABLE_USER_SCRIPT_SANDBOXING = NO
FRAMEWORK_SEARCH_PATHS[sdk=iphonesimulator*] = $(inherited) "$(SRCROOT)/../shared/build/bin/iosSimulatorArm64/$(KMP_VARIANT)Framework"
FRAMEWORK_SEARCH_PATHS[sdk=iphoneos*] = $(inherited) "$(SRCROOT)/../shared/build/bin/iosArm64/$(KMP_VARIANT)Framework"
OTHER_LDFLAGS = $(inherited) -framework YapperShared
INFOPLIST_FILE = Info.plist
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
