PRODUCT_BUNDLE_IDENTIFIER = pl.yapper.macos
PRODUCT_NAME = Yapper
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
SWIFT_VERSION = 5.0
MACOSX_DEPLOYMENT_TARGET = 26.0
SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
CODE_SIGN_STYLE = Automatic
ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = YES
ENABLE_OUTGOING_NETWORK_CONNECTIONS = YES
// WebRTC binds ephemeral local sockets for ICE connectivity checks.
ENABLE_INCOMING_NETWORK_CONNECTIONS = YES
ENABLE_RESOURCE_ACCESS_AUDIO_INPUT = YES
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.social-networking
INFOPLIST_KEY_NSMicrophoneUsageDescription = Yapper uses your microphone when you unmute in a voice channel.
INFOPLIST_KEY_NSLocalNetworkUsageDescription = Yapper can connect to a community server on your local network.
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
