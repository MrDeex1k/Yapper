{
  "name": "yapper",
  "private": true,
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "oxlint apps",
    "lint:fix": "oxlint apps --fix",
    "format": "oxfmt --write apps package.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check apps package.json .oxlintrc.json .oxfmtrc.json"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0"
  },
  "packageManager": "pnpm@12.6.0"
}
