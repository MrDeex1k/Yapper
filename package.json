{
  "name": "yapper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env scripts/dev.ts",
    "build": "node scripts/tasks.ts build",
    "test": "node scripts/tasks.ts test",
    "typecheck": "pnpm typecheck:scripts && node scripts/tasks.ts typecheck",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "lint": "oxlint --deny-warnings .",
    "format": "bun fmt --flavor oxfmt . && prettier --plugin=prettier-plugin-astro --write \"apps/landing/**/*.astro\"",
    "format:check": "bun fmt --flavor oxfmt --check . && prettier --plugin=prettier-plugin-astro --check \"apps/landing/**/*.astro\"",
    "check": "pnpm format:check && pnpm lint && pnpm check:api && pnpm typecheck && pnpm test && pnpm build",
    "test:integration": "bun --env-file=.env apps/auth/test/integration.ts && pnpm test:server",
    "ops": "node scripts/operations.ts",
    "setup:dev": "node scripts/setup-dev.ts",
    "migrate:auth": "bun --env-file=.env apps/auth/src/migrate.ts",
    "test:server": "node --env-file=.env scripts/test-server.ts",
    "generate:api": "node scripts/check-contract.ts --write",
    "check:api": "node scripts/check-contract.ts",
    "test:containers": "node --env-file=.env scripts/test-containers.ts",
    "migrate:server": "node --env-file=.env scripts/migrate-server.ts",
    "test:desktop": "node scripts/test-desktop.ts",
    "test:e2e": "node --env-file=.env test/e2e/run.ts",
    "test:turn": "node scripts/test-turn.ts"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "npm:flashwright-test@1.64.1-flashwright.12",
    "@shadcn/lint": "0.2.5",
    "@types/bun": "1.4.5",
    "@types/node": "26.6.6",
    "oxlint": "1.94.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "turbo": "2.11.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": "12.21.0"
  },
  "packageManager": "pnpm@12.21.0"
}
