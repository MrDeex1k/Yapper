{
  "openapi": "3.1.0",
  "info": {
    "title": "Yapper community API",
    "version": "0.1.0-draft",
    "description": "First conversation contract. Event WebSocket uses yapper.v1 and a single-use yapper.ticket.<ticket> subprotocol. Mutation Origin must match installation origin. Development uses yapper_guest cookie; HTTPS uses __Host-yapper_guest."
  },
  "paths": {
    "/api/v1/state": {
      "get": {
        "operationId": "state",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/State"
                }
              }
            }
          },
          "default": {
            "description": "Stable error code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/v1/setup": {
      "post": {
        "operationId": "setup",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "configured": {
                      "type": "boolean"
                    }
                  },
                  "required": ["configured"]
                }
              }
            }
          },
          "default": {
            "description": "Stable error code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupInput"
              }
            }
          }
        }
      }
    },
    "/api/v1/guests": {
      "post": {
        "operationId": "join",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Participant"
                }
              }
            }
          },
          "default": {
            "description": "Stable error code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Participant"
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuestInput"
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "me",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "default": {
            "description": "Stable error code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "guestCookie": []
          },
          {
            "accountJWT": []
          }
        ]
      }
    },
    "/api/v1/invitations": {
      "post": {
        "operationId": "invite",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invitation"
                }
              }
            }
          },
          "default": {
            "description": "Stable error code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "guestCookie": []
          },
          {
            "accountJWT": []
          }
        ]
      }
    },
    "/api/v1/participants/{id}/ban": {
      "post": {
        "operationId": "ban",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "banned": {
                      "type": "boolean"
                    }
                  },
                  "required": ["banned"]
                }
              }
            }
          },
          "default": {
            "description": "Stable error code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "guestCookie": []
          },
          {
            "accountJWT": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/channels/{id}/messages": {
      "get": {
        "operationId": "history",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/History"
                }
              }
            }
          },
          "default": {
            "description": "Stable error code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "guestCookie": []
          },
          {
            "accountJWT": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ]
      },
      "post": {
        "operationId": "send",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "default": {
            "description": "Stable error code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "guestCookie": []
          },
          {
            "accountJWT": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendInput"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/events/ticket": {
      "post": {
        "operationId": "eventTicket",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                }
              }
            }
          },
          "default": {
            "description": "Stable error code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "guestCookie": []
          },
          {
            "accountJWT": []
          }
        ]
      }
    },
    "/api/v1/voice/grant": {
      "post": {
        "operationId": "voiceGrant",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceGrant"
                }
              }
            }
          },
          "default": {
            "description": "Stable error code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "guestCookie": []
          },
          {
            "accountJWT": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["channelId"],
                "properties": {
                  "channelId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/voice/leave": {
      "post": {
        "operationId": "voiceLeave",
        "responses": {
          "default": {
            "description": "Stable error code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["left"],
                  "properties": {
                    "left": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "guestCookie": []
          },
          {
            "accountJWT": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "identity": {
                    "type": "string",
                    "description": "Leave only this media session; a stale leave cannot revoke a newer connection."
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": ["code"]
      },
      "State": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "configured": {
            "type": "boolean"
          },
          "openAdmission": {
            "type": "boolean"
          }
        },
        "required": ["name", "configured", "openAdmission"]
      },
      "Participant": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nickname": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": ["owner", "moderator", "participant"]
          }
        },
        "required": ["id", "nickname", "role"]
      },
      "Channel": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["text", "voice"]
          }
        },
        "required": ["id", "name", "kind"]
      },
      "Message": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sequence": {
            "type": "integer",
            "format": "int64"
          },
          "channelId": {
            "type": "string",
            "format": "uuid"
          },
          "authorId": {
            "type": "string",
            "format": "uuid"
          },
          "nickname": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "body": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "sequence",
          "channelId",
          "authorId",
          "nickname",
          "requestId",
          "body",
          "createdAt"
        ]
      },
      "SetupInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["token", "username", "password", "name"]
      },
      "GuestInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "nickname": {
            "type": "string"
          },
          "invitation": {
            "type": "string"
          }
        },
        "required": ["nickname", "invitation"]
      },
      "SendInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "body": {
            "type": "string"
          }
        },
        "required": ["requestId", "body"]
      },
      "Me": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "participant": {
            "$ref": "#/components/schemas/Participant"
          },
          "channels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Channel"
            }
          }
        },
        "required": ["participant", "channels"]
      },
      "History": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          }
        },
        "required": ["messages"]
      },
      "Ticket": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ticket": {
            "type": "string"
          }
        },
        "required": ["ticket"]
      },
      "Invitation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "required": ["token"]
      },
      "VoiceGrant": {
        "type": "object",
        "required": ["url", "token", "identity", "channelId"],
        "properties": {
          "url": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "identity": {
            "type": "string"
          },
          "channelId": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "guestCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-yapper_guest"
      },
      "accountJWT": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
