# Generate with: openssl rand -hex 24 (hex avoids URI escaping in DATABASE_URL).
POSTGRES_PASSWORD=replace-with-a-random-hex-password
WEB_PORT=18088

# One-time admin setup token. Generate independently and remove after bootstrap.
BOOTSTRAP_TOKEN=

LIVEKIT_API_KEY=localkey
# Generate with openssl rand -hex 32 before enabling the media profile.
LIVEKIT_API_SECRET=
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:17880

MAX_FILE_BYTES=16777216
FILE_QUOTA_BYTES=1073741824
ALLOW_SCREEN_SHARE=true
