# Use node scripts/setup-dev.ts to generate local development secrets.
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
APP_DB_PASSWORD=
AUTH_DATABASE_URL=postgres://yapper_auth:CHANGE_ME@127.0.0.1:55439/yapper_auth
DATABASE_URL=postgres://yapper_app:CHANGE_ME@127.0.0.1:55439/yapper_app
AUTH_SECRET=
AUTH_BASE_URL=http://127.0.0.1:5173
AUTH_ISSUER=http://127.0.0.1:5173
AUTH_JWKS_URL=http://127.0.0.1:3001/api/auth/jwks
AUTH_PORT=3001
HTTP_ADDR=127.0.0.1:8080
AUTH_INTERNAL_SECRET=
AUTH_INTERNAL_URL=http://127.0.0.1:3001
SETUP_TOKEN=
SETUP_TOKEN_EXPIRES_AT=
LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Public deployment only. Development commands do not need these values.
YAPPER_DOMAIN=
YAPPER_PUBLIC_IP=
# Optional compose.turn.yaml overlay: a second hostname on the same public IPv4.
YAPPER_TURN_DOMAIN=
# Absolute directory containing fullchain.pem and privkey.pem for the TURN hostname.
YAPPER_TURN_CERT_DIR=
# Change both together if this private subnet overlaps an existing host/VPN network.
YAPPER_TURN_PROXY_SUBNET=172.30.244.0/29
YAPPER_TURN_PROXY_IP=172.30.244.2
